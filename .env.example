# Copiar como .env solo para desarrollo local con "netlify dev".
# En produccion estas variables se configuran en Netlify:
# Project configuration > Environment variables.

# Cadena de conexion de Supabase (Connect > Transaction pooler, puerto 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Texto aleatorio de al menos 32 caracteres para firmar las sesiones.
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio-de-32-o-mas-caracteres

# Contrasena del panel de administrador (minimo 8 caracteres).
ADMIN_PASSWORD=cambiar-esta-contrasena
